{
  "expo": {
    "name": "GameLoot - Play & Earn",
    "slug": "gameloot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gameloot.app"
    },
    "android": {
      "package": "com.gameloot.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090d16"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#090d16",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://gameloot.youplex.cc/api",
      "socketUrl": "https://gameloot.youplex.cc",
      "localApiUrl": "http://localhost:5000/api",
      "localSocketUrl": "http://localhost:5000"
    }
  }
}
